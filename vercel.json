{
  "crons": [
    {
      "path": "/api/scheduled-notify",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/flashtopup-deliver.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/success", "destination": "/index.html" },
    { "source": "/payment/success", "destination": "/index.html" },
    { "source": "/payment/cancel", "destination": "/index.html" }
  ]
}
